{
  /* Tests are typechecked as their own project rather than inside
     tsconfig.app.json. They legitimately use Node builtins (reading the real
     datasets from disk to exercise the routing engine end to end), and adding
     "node" to the app project's types would let application source reach for
     Node APIs that do not exist in a browser and still typecheck. Keeping the
     two separate preserves that guarantee for the shipped code while still
     typechecking the tests -- this project is referenced from tsconfig.json,
     so `tsc -b` covers both. */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["node", "vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
